# Пример конфигурации окружения для локального запуска
# Скопируйте в .env и подставьте свои значения

# API ключ OpenRouter (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_api_key_here
BASE_URL=https://openrouter.ai/api/v1

# Каналы Telegram-уведомлений:
# 1) Мост-прокси (приоритет, используется в APK при сборке из GitHub Secrets)
TELEGRAM_BRIDGE_URL=
TELEGRAM_BRIDGE_SECRET=
# 2) Прямой доступ к Bot API (fallback, токен от @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
