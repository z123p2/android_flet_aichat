# Пример конфигурации окружения для локального запуска
# Скопируйте в .env и подставьте свои значения

# API ключ OpenRouter (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_api_key_here
BASE_URL=https://openrouter.ai/api/v1

# Токен Telegram-бота от @BotFather (для уведомлений о низком балансе)
# При сборке APK токен подставляется из GitHub Secrets и этот файл не нужен
TELEGRAM_BOT_TOKEN=your_bot_token_here
